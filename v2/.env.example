# Copy this file to .env and fill in your own values. NEVER commit .env.
# .env itself is gitignored; this example must stay key-free.

# NVIDIA NIM (OpenAI-compatible). App works without keys (rules+keyword fallback).
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_CHAT_MODEL=openai/gpt-oss-20b
NIM_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
NIM_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# Qdrant Cloud (free tier): https://cloud.qdrant.io → cluster → API keys.
# URL looks like: https://xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=mmrag

# Legacy / optional
GEMINI_API_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mmrag
API_URL=http://localhost:7860
